{
  "name": "numbertown",
  "version": "4.13.0",
  "description": "A local 3D playground with Numberblock friends Zero through Fifty.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "python3 serve.py",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:server": "python3 -m unittest discover -s tests -p \"test_*.py\""
  }
}
